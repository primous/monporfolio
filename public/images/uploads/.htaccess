# Dossier des fichiers téléversés depuis l'admin : des images uniquement, jamais de code exécuté.

# Aucun script interprété ici (PHP, CGI…)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
Options -ExecCGI -Indexes

# Seules les images sont servies
<IfModule mod_authz_core.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|webp|gif|avif)$">
        Require all granted
    </FilesMatch>
</IfModule>

# Le navigateur ne devine pas le type (pas de HTML déguisé en image)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
