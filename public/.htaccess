<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Sécurité : aucun fichier caché servi (.env, .git…), sauf /.well-known (security.txt, SSL).
    # Envoyés à Laravel (et non refusés ici) pour que DetecteurDeScans les journalise et bloque l'IP.
    RewriteRule (^|/)\.(?!well-known(/|$)) index.php [L]

    # SEO : une seule adresse pour le site en ligne -> https://hounkpatinprimous.com
    # (limité à ce domaine : sans effet en local)
    RewriteCond %{HTTP_HOST} ^(www\.)?hounkpatinprimous\.com$ [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://hounkpatinprimous.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Vitesse : compression des fichiers texte (HTML, CSS, JS, SVG, JSON, XML)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Vitesse : cache navigateur
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Fichiers servis directement par Apache (images, CSS, JS, security.txt) : mêmes en-têtes que Laravel.
# « setifempty » : ne remplace pas ceux que Laravel envoie déjà pour les pages.
<IfModule mod_headers.c>
    Header always setifempty X-Content-Type-Options "nosniff"
    Header always setifempty X-Frame-Options "DENY"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Les fichiers du build Vite portent une empreinte dans leur nom : cache long et immuable
<IfModule mod_headers.c>
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
