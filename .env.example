APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@hounkpatinprimous.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@hounkpatinprimous.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_PHONE=
SITE_EMAIL=
SITE_WHATSAPP=
SITE_NOTIFY_EMAIL=
SITE_ADMIN_EMAIL=

TRUSTED_PROXIES=
CSP_ENFORCE=false

# ---------------------------------------------------------------------------
# EN PRODUCTION (fichier .env du serveur) — valeurs à changer à la main :
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://hounkpatinprimous.com
# APP_KEY=            -> php artisan key:generate (une clé propre au serveur)
# APP_LOCALE=fr
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_LEVEL=error
# LOG_DAILY_DAYS=14
# SESSION_SECURE_COOKIE=true
# SESSION_LIFETIME=60
# DB_CONNECTION=mysql (+ utilisateur MySQL dédié, mot de passe long, jamais root)
# TRUSTED_PROXIES=*   -> uniquement si le site passe par Cloudflare ou un répartiteur
# CSP_ENFORCE=true    -> une fois la console du navigateur sans alerte CSP en ligne
# ---------------------------------------------------------------------------

# Sauvegardes (spatie/laravel-backup)
BACKUP_NAME=myportfolio
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
DB_DUMP_PATH=

# Admin discrète (voir SECURITY.md)
# ADMIN_PATH : adresse de l'admin, sans « / ». En ligne, une valeur difficile à deviner
# (ex. php -r "echo 'gestion-'.bin2hex(random_bytes(5));"). Vide = « admin ».
ADMIN_PATH=
# IP autorisées (virgules, CIDR accepté). Vide = aucune restriction.
ADMIN_ALLOWED_IPS=
ADMIN_IDLE_MINUTES=15
